# ─────────────────────────────────────────────────────────────
# SkyLark Drone Operations Coordinator — Environment Variables
# ─────────────────────────────────────────────────────────────

# REQUIRED: Gemini API key
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL: Google Sheets 2-way sync
# If not set, the agent falls back to local CSV files (data/ directory)

# Full JSON content of your Google service account key (single line, no newlines)
# Steps:
#   1. Google Cloud Console → IAM & Admin → Service Accounts → Create
#   2. Keys tab → Add Key → JSON → Download
#   3. Minify: python3 -c "import json,sys; print(json.dumps(json.load(open(sys.argv[1]))))" key.json
#   4. Paste the output below
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"YOUR_PROJECT",...}

# ── Option A: One spreadsheet with 3 tabs (Pilots / Drones / Missions) ─────────
# SPREADSHEET_ID=your_single_spreadsheet_id_here

# ── Option B: Three separate spreadsheets (one per data type) ───────────────────
# URL format: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID_HERE/edit
PILOTS_SPREADSHEET_ID=your_pilots_spreadsheet_id_here
DRONES_SPREADSHEET_ID=your_drones_spreadsheet_id_here
MISSIONS_SPREADSHEET_ID=your_missions_spreadsheet_id_here

# REQUIRED in production (Render auto-generates this; set manually for local dev)
# Any random 32+ character string
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
CHAINLIT_AUTH_SECRET=change_me_to_any_random_32_char_string
